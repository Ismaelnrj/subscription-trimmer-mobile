.expo/
# .claude holds local session state (settings.local.json and friends) which
# should stay local, but .claude/skills is a project asset: a skill lives in
# the repo precisely so everyone working on Trimio gets it. Git will not
# descend into an ignored directory, so the exclusion has to be written as
# "everything under .claude except skills" rather than a bare negation.
.claude/*
!.claude/skills/
.agents/
node_modules/
dist/
skills-lock.json

# Regenerated fresh by `npx expo prebuild --clean` on every Codemagic build.
# A committed copy made EAS tooling detect this project as bare workflow for
# Android while iOS (no committed ios/) stayed managed, a split-brain state
# that broke runtime version resolution for OTA updates.
android/
ios/

# Google Play service account key used by `eas submit` — never commit this
google-play-service-account.json

# Signing keystores and certificates — never commit these
*.jks
*.keystore
*.pem
*.p12

# Rendered video cuts. Regenerate with tools/make-cut.py.
build/

# Source recordings. Large, and the cut specs reference them by path.
raw/

# Compiled Python bytecode. Never source, churns on every interpreter
# version, and three of these were tracked for over a week before anyone
# noticed because a .pyc never shows up in a readable diff.
__pycache__/
*.py[cod]

# Environment files. Nothing of the sort is tracked today and nothing should
# be: every secret this project has lives in Railway, Codemagic or GitHub
# Actions. .env.example is exempt so a checked in template stays possible.
# google-services.json IS tracked on purpose and is not an exception to this:
# the Firebase Android key in it is public by design, restricted by package
# name plus signing certificate, and moving it out would break the build for
# no security gain.
.env
.env.*
!.env.example
